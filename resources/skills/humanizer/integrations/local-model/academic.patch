+"""Conservative change alarms for academic prose; not a semantic verifier."""
+from collections import Counter
+import hashlib
+import re
+
+PROFILES = (
+    'general', 'nature', 'applied-sciences', 'results-in-engineering',
+    'caadria', 'clinical', 'materials', 'buildings', 'sustainability',
+    'automation-in-construction',
+)
+
+# Match amounts with their adjacent units. Exact comparison deliberately also
+# flags harmless notation changes, which a researcher can review separately.
+NUMBER = r'(?<![\w.])[+−-]?(?:\d+(?:[,.]\d+)*|\.\d+)(?:[eE][+−-]?\d+)?'
+UNIT = r'(?:%|°\s?[CF]|MPa|GPa|kPa|Pa|mm|cm|km|m|ms|s|Hz|kHz|kg|mg|g|mL|L|K|N|W)(?![A-Za-z])'
+PATTERNS = {
+    'numbers': re.compile(NUMBER),
+    'quantities': re.compile(NUMBER + r'\s*' + UNIT),
+    'citations': re.compile(r'\[\d+(?:\s*[,;–-]\s*\d+)*\]|\\(?:cite\w*|ref|eqref)\*?(?:\[[^\]]*\])*\{[^}]+\}|\([^()\n]*\b(?:19|20)\d{2}[a-z]?[^()\n]*\)'),
+    'math': re.compile(r'(?<!\$)\$(?!\$)[^$\n]+\$(?!\$)|\\\([^\n]*?\\\)'),
+    'code': re.compile(r'`[^`\n]+`'),
+    'claim_cues': re.compile(r"\b(?:may|might|could|suggest\w*|associat\w*|correlat\w*|caus\w*|prov\w*|significant\w*|not|no|never|without|cannot|increase\w*|decrease\w*|higher|lower|equivalent|noninferior|non-inferior)\b|\b\w+n['’]t\b", re.I),
+}
+
+
+def changes(draft, candidate, protected=()):
+    """Return alarms in either direction. Absence of alarms is not approval."""
+    issues = []
+    for label, pattern in PATTERNS.items():
+        def tokens(text):
+            return Counter(re.sub(r'\s+', ' ', m.group()).lower()
+                           if label == 'claim_cues' else re.sub(r'\s+', ' ', m.group())
+                           for m in pattern.finditer(text))
+        if tokens(draft) != tokens(candidate):
+            issues.append('academic_' + label)
+    for phrase in protected:
+        if draft.count(phrase) != candidate.count(phrase):
+            issues.append('academic_protected')
+            break
+    return issues
+
+
+def digest(text):
+    return hashlib.sha256(text.encode('utf-8')).hexdigest()
