@@ -0,0 +1,88 @@
+"""Academic regression tests use a fake backend; no weights or detector API."""
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from humanizer import academic, hz, hz_text
+from test_hz import Fake, run_hz
+
+
+class AcademicTests(unittest.TestCase):
+    def test_scientific_change_alarms(self):
+        cases = [
+            ('37 complaints', '37% complaints', 'academic_quantities'),
+            ('5 MPa at 10 mm', '5 mm at 10 MPa', 'academic_quantities'),
+            ('It may improve outcomes.', 'It improves outcomes.', 'academic_claim_cues'),
+            ('It was not significant.', 'It was significant.', 'academic_claim_cues'),
+            ('It is associated with X.', 'It causes X.', 'academic_claim_cues'),
+            ('See [12] and [12].', 'See [12].', 'academic_citations'),
+            ('Smith et al. (2020)', 'Smith et al. (2021)', 'academic_citations'),
+            (r'The term $x^2$ applies.', r'The term $x^3$ applies.', 'academic_math'),
+            ('A 2e-3 m gap', 'A 2e-2 m gap', 'academic_quantities'),
+        ]
+        for before, after, issue in cases:
+            with self.subTest(before=before):
+                self.assertIn(issue, academic.changes(before, after))
+
+    def test_protected_terms(self):
+        self.assertIn('academic_protected', academic.changes('KinemaAnchor worked.', 'Another model worked.', ['KinemaAnchor']))
+
+    def test_unchanged_and_safe_reorder(self):
+        a = 'At 28 days, the mean was 5 MPa [2]. It may help.'
+        b = 'The mean was 5 MPa [2] at 28 days. It may help.'
+        self.assertEqual([], academic.changes(a, b))
+        self.assertEqual([], academic.changes(a, a))
+
+    def test_retains_original_and_full_audit(self):
+        draft = 'The trial enrolled 37 participants and the results may suggest an association with better outcomes [12].'
+        fake = Fake(rule=lambda d, n: d.replace('37', '37%').replace('may suggest', 'prove'))
+        try:
+            code, stdout, stderr = run_hz('--server', fake.url, '--academic', 'clinical', '--json', stdin=draft.encode())
+            report = json.loads(stdout)
+            self.assertEqual(4, code)
+            self.assertEqual(draft, report['text'].strip())
+            piece = report['pieces'][0]['academic']
+            self.assertTrue(piece['restored_original'])
+            self.assertEqual(2, len(piece['candidates']))
+            self.assertEqual(academic.digest(draft), piece['output_sha256'])
+            self.assertIn('kept original', stderr)
+            for _, _, body in fake.completions():
+                self.assertEqual(hz.build_prompt(draft), body['prompt'])
+                for key, value in hz.SAMPLING.items():
+                    self.assertEqual(value, body[key])
+        finally:
+            fake.close()
+
+    def test_copying_is_allowed_in_academic_mode(self):
+        draft = 'The specimens were tested after 28 days and the average compressive strength was 5 MPa across all samples.'
+        fake = Fake(rule=lambda d, n: d)
+        try:
+            code, stdout, _ = run_hz('--server', fake.url, '--academic', 'results-in-engineering', '--json', stdin=draft.encode())
+            report = json.loads(stdout)
+            self.assertEqual(0, code)
+            self.assertEqual(1, len(fake.completions()))
+            self.assertEqual('needs_human_review', report['pieces'][0]['academic']['status'])
+            self.assertTrue(report['academic']['review_required'])
+        finally:
+            fake.close()
+
+    def test_valid_retry_beats_changed_claim(self):
+        draft = 'The specimens may show a difference after 28 days of curing under the controlled laboratory conditions described here.'
+        fake = Fake(rule=lambda d, n: d.replace('may', 'will') if n == 0 else d)
+        try:
+            code, stdout, _ = run_hz('--server', fake.url, '--academic', 'general', '--json', stdin=draft.encode())
+            report = json.loads(stdout)
+            self.assertEqual(0, code)
+            self.assertEqual(2, report['pieces'][0]['chosen'])
+            self.assertFalse(report['pieces'][0]['academic']['restored_original'])
+        finally:
+            fake.close()
+
+    def test_requires_audit_output(self):
+        code, _, _ = run_hz('--academic', 'nature', stdin=b'Example text.')
+        self.assertEqual(2, code)
+
+
+if __name__ == '__main__':
+    unittest.main()
